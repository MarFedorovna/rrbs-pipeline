from pathlib import Path
import sys
sys.path.insert(0, str(Path(workflow.basedir)))
from lib import load_samples, validate_config

configfile: "config/config.yaml"

SAMPLES = load_samples(config["samples"])
validate_config(config, SAMPLES)
IDS = list(SAMPLES)
OUT = config["outdir"].rstrip("/")
REF = config["reference_dir"].rstrip("/")
CHROMS = config["canonical_chromosomes"]
CPU = config["threads"]
MEM = config["memory_mb"]
shell.executable("/bin/bash")

rule all:
    input:
        OUT + "/multiqc/multiqc_report.html",
        OUT + "/analysis/summary.json",
        OUT + "/annotation/summary.json",
        OUT + "/provenance/run.json",
        expand(OUT + "/bismark/{sample}/report.html", sample=IDS)

rule prepare_data:
    input:
        fastq=expand("data/raw/{sample}_R{mate}.fastq.gz", sample=IDS, mate=[1, 2]),
        fasta=REF + "/genome/hg38.fa",
        index=REF + "/genome/Bisulfite_Genome",
        genes=REF + "/annotation/genes.bed",
        promoters=REF + "/annotation/promoters.bed",
        islands=REF + "/annotation/islands.bed"

rule fetch_fastq:
    input:
        local=lambda w: [SAMPLES[w.sample]["r" + w.mate]] if not SAMPLES[w.sample]["r" + w.mate].startswith(("http://", "https://", "ftp://")) else []
    output:
        "data/raw/{sample}_R{mate}.fastq.gz"
    wildcard_constraints:
        mate="[12]"
    params:
        source=lambda w: SAMPLES[w.sample]["r" + w.mate],
        md5=lambda w: SAMPLES[w.sample]["md5_r" + w.mate]
    resources:
        mem_mb=256, downloads=1
    log:
        OUT + "/logs/fetch/{sample}_R{mate}.log"
    shell:
        "python scripts/fetch.py {params.source:q} {output:q} --md5={params.md5:q} > {log:q} 2>&1"

rule download_reference:
    output:
        REF + "/source/hg38.fa.gz"
    params:
        url=config["reference_url"]
    resources:
        mem_mb=256, downloads=1
    log:
        OUT + "/logs/reference_download.log"
    shell:
        "python scripts/fetch.py {params.url:q} {output:q} > {log:q} 2>&1"

rule reference_fasta:
    input:
        REF + "/source/hg38.fa.gz"
    output:
        REF + "/genome/hg38.fa"
    resources:
        mem_mb=512
    params:
        parent=REF + "/genome"
    shell:
        "mkdir -p {params.parent:q}; gzip -dc {input:q} > {output:q}"

rule bismark_index:
    input:
        REF + "/genome/hg38.fa"
    output:
        index=directory(REF + "/genome/Bisulfite_Genome")
    threads: CPU["index"]
    resources:
        mem_mb=MEM["index"]
    params:
        genome=REF + "/genome",
        parallel=lambda w, threads: "--parallel " + str(threads // 2) if threads >= 4 else ""
    log:
        OUT + "/logs/index.log"
    benchmark:
        OUT + "/benchmarks/index.tsv"
    shell:
        "bismark_genome_preparation --bowtie2 {params.parallel} {params.genome:q} > {log:q} 2>&1"

rule fastqc:
    input:
        "data/raw/{sample}_R{mate}.fastq.gz"
    output:
        html=OUT + "/fastqc/raw/{sample}_R{mate}_fastqc.html",
        zip=OUT + "/fastqc/raw/{sample}_R{mate}_fastqc.zip"
    wildcard_constraints:
        mate="[12]"
    threads: 1
    resources:
        mem_mb=1024
    params:
        out=OUT + "/fastqc/raw"
    log:
        OUT + "/logs/fastqc/{sample}_R{mate}.log"
    shell:
        "mkdir -p {params.out:q}; fastqc -t {threads} -o {params.out:q} {input:q} > {log:q} 2>&1"

rule trim:
    input:
        r1="data/raw/{sample}_R1.fastq.gz",
        r2="data/raw/{sample}_R2.fastq.gz"
    output:
        r1=OUT + "/trimmed/{sample}_val_1.fq.gz",
        r2=OUT + "/trimmed/{sample}_val_2.fq.gz",
        qc1=OUT + "/trimmed/{sample}_val_1_fastqc.zip",
        qc2=OUT + "/trimmed/{sample}_val_2_fastqc.zip",
        report1=OUT + "/trimmed/{sample}_R1.fastq.gz_trimming_report.txt",
        report2=OUT + "/trimmed/{sample}_R2.fastq.gz_trimming_report.txt"
    threads: CPU["trim"]
    resources:
        mem_mb=MEM["trim"]
    params:
        out=OUT + "/trimmed", quality=config["trim_quality"], length=config["trim_length"],
        cores=lambda w, threads: max(1, (threads - 1) // 3),
        rrbs="--rrbs --non_directional" if config["non_directional"] else "--rrbs"
    log:
        OUT + "/logs/trim/{sample}.log"
    benchmark:
        OUT + "/benchmarks/trim/{sample}.tsv"
    shell:
        """
        mkdir -p {params.out:q}
        trim_galore {params.rrbs} --paired --illumina --gzip --fastqc \
            --cores {params.cores} --quality {params.quality} --length {params.length} \
            --basename {wildcards.sample:q} -o {params.out:q} {input.r1:q} {input.r2:q} > {log:q} 2>&1
        """

rule align:
    input:
        r1=OUT + "/trimmed/{sample}_val_1.fq.gz",
        r2=OUT + "/trimmed/{sample}_val_2.fq.gz",
        index=REF + "/genome/Bisulfite_Genome",
        fasta=REF + "/genome/hg38.fa"
    output:
        bam=OUT + "/bam/{sample}/{sample}_pe.bam",
        report=OUT + "/bam/{sample}/{sample}_PE_report.txt"
    threads: CPU["align"]
    resources:
        mem_mb=MEM["align"]
    params:
        out=lambda w: OUT + "/bam/" + w.sample,
        genome=REF + "/genome",
        direction="--non_directional" if config["non_directional"] else "",
        bowtie_options=lambda w, threads: "-p " + str((threads - 2) // (4 if config["non_directional"] else 2)) if (threads - 2) // (4 if config["non_directional"] else 2) >= 2 else ""
    log:
        OUT + "/logs/align/{sample}.log"
    benchmark:
        OUT + "/benchmarks/align/{sample}.tsv"
    shell:
        """
        mkdir -p {params.out:q}
        bismark --bowtie2 --bam {params.direction} {params.bowtie_options} \
            --basename {wildcards.sample:q} -o {params.out:q} {params.genome:q} \
            -1 {input.r1:q} -2 {input.r2:q} > {log:q} 2>&1
        samtools quickcheck -v {output.bam:q} >> {log:q} 2>&1
        """

# RRBS: retain genuine reads at the same restriction sites. No coordinate deduplication.
# Keep the original paired-order BAM for extraction; never coordinate-sort it in place.
rule extract:
    input:
        OUT + "/bam/{sample}/{sample}_pe.bam"
    output:
        cov=OUT + "/methylation/{sample}/{sample}_pe.bismark.cov.gz",
        splitting=OUT + "/methylation/{sample}/{sample}_pe_splitting_report.txt",
        mbias=OUT + "/methylation/{sample}/{sample}_pe.M-bias.txt"
    threads: CPU["extract"]
    resources:
        mem_mb=MEM["extract"]
    params:
        out=lambda w: OUT + "/methylation/" + w.sample,
        parallel=lambda w, threads: max(1, threads // 3),
        i1=config["ignore_r1"], i2=config["ignore_r2"],
        e1=config["ignore_3prime_r1"], e2=config["ignore_3prime_r2"]
    log:
        OUT + "/logs/extract/{sample}.log"
    benchmark:
        OUT + "/benchmarks/extract/{sample}.tsv"
    shell:
        """
        mkdir -p {params.out:q}
        bismark_methylation_extractor --paired-end --parallel {params.parallel} \
            --gzip --bedGraph --buffer_size 2G --comprehensive --merge_non_CpG --no_overlap \
            --ignore {params.i1} --ignore_r2 {params.i2} \
            --ignore_3prime {params.e1} --ignore_3prime_r2 {params.e2} \
            -o {params.out:q} {input:q} > {log:q} 2>&1
        """

rule filter_coverage:
    input:
        OUT + "/methylation/{sample}/{sample}_pe.bismark.cov.gz"
    output:
        OUT + "/coverage/{sample}.cov.gz"
    params:
        chromosomes=CHROMS
    resources:
        mem_mb=512
    shell:
        "python scripts/filter_coverage.py {input:q} {output:q} {params.chromosomes:q}"

rule bismark_report:
    input:
        alignment=OUT + "/bam/{sample}/{sample}_PE_report.txt",
        splitting=OUT + "/methylation/{sample}/{sample}_pe_splitting_report.txt",
        mbias=OUT + "/methylation/{sample}/{sample}_pe.M-bias.txt"
    output:
        OUT + "/bismark/{sample}/report.html"
    params:
        out=lambda w: OUT + "/bismark/" + w.sample
    resources:
        mem_mb=1024
    log:
        OUT + "/logs/report/{sample}.log"
    shell:
        """
        mkdir -p {params.out:q}
        bismark2report --alignment_report {input.alignment:q} --splitting_report {input.splitting:q} \
            --mbias_report {input.mbias:q} -o report.html --dir {params.out:q} > {log:q} 2>&1
        """

rule differential:
    input:
        coverage=expand(OUT + "/coverage/{sample}.cov.gz", sample=IDS),
        samples=config["samples"]
    output:
        summary=OUT + "/analysis/summary.json",
        dmp=OUT + "/analysis/dmp_all.tsv.gz",
        tiles=OUT + "/analysis/tiles_all.tsv.gz",
        qc=OUT + "/analysis/qc.pdf",
        session=OUT + "/analysis/sessionInfo.txt",
        counts=OUT + "/analysis/site_counts.tsv",
        order=OUT + "/analysis/sample_order.tsv",
        correlation=OUT + "/analysis/correlation.tsv",
        pca=OUT + "/analysis/pca_scores.tsv",
        matrix=OUT + "/analysis/methylBase.rds",
        dmp_sig=OUT + "/analysis/dmp_significant.tsv.gz",
        dmp_hyper=OUT + "/analysis/dmp_hyper.tsv.gz",
        dmp_hypo=OUT + "/analysis/dmp_hypo.tsv.gz",
        dmp_bed=OUT + "/analysis/dmp_significant.bed",
        tile_sig=OUT + "/analysis/tiles_significant.tsv.gz",
        tile_hyper=OUT + "/analysis/tiles_hyper.tsv.gz",
        tile_hypo=OUT + "/analysis/tiles_hypo.tsv.gz",
        tile_bed=OUT + "/analysis/tiles_significant.bed"
    threads: CPU["differential"]
    resources:
        mem_mb=MEM["differential"]
    params:
        cfg=config, ids=IDS, out=OUT + "/analysis"
    log:
        OUT + "/logs/differential.log"
    benchmark:
        OUT + "/benchmarks/differential.tsv"
    script:
        "../scripts/analyze.R"

rule fetch_annotation:
    output:
        REF + "/source/{kind}.txt.gz"
    wildcard_constraints:
        kind="genes|islands"
    params:
        url=lambda w: config[w.kind + "_url"]
    resources:
        mem_mb=256, downloads=1
    shell:
        "python scripts/fetch.py {params.url:q} {output:q}"

rule prepare_annotations:
    input:
        genes=REF + "/source/genes.txt.gz",
        islands=REF + "/source/islands.txt.gz"
    output:
        genes=REF + "/annotation/genes.bed",
        promoters=REF + "/annotation/promoters.bed",
        islands=REF + "/annotation/islands.bed"
    params:
        out=REF + "/annotation", chromosomes=CHROMS,
        upstream=config["promoter_upstream"], downstream=config["promoter_downstream"]
    resources:
        mem_mb=2048
    shell:
        """
        python scripts/prepare_annotations.py {input.genes:q} {input.islands:q} {params.out:q} \
            --chromosomes {params.chromosomes:q} --upstream {params.upstream} --downstream {params.downstream}
        """

rule annotate:
    input:
        dmp=OUT + "/analysis/dmp_all.tsv.gz",
        tiles=OUT + "/analysis/tiles_all.tsv.gz",
        genes=REF + "/annotation/genes.bed",
        promoters=REF + "/annotation/promoters.bed",
        islands=REF + "/annotation/islands.bed"
    output:
        summary=OUT + "/annotation/summary.json",
        dmp=OUT + "/annotation/dmp_annotated.tsv.gz",
        tiles=OUT + "/annotation/tiles_annotated.tsv.gz",
        dmp_genes=OUT + "/annotation/dmp_genes.txt",
        tile_genes=OUT + "/annotation/tiles_genes.txt",
        dmp_background=OUT + "/annotation/dmp_background_genes.txt",
        tile_background=OUT + "/annotation/tiles_background_genes.txt",
        dmp_go=OUT + "/annotation/dmp_go.tsv",
        tile_go=OUT + "/annotation/tiles_go.tsv"
    params:
        cfg=config, out=OUT + "/annotation"
    threads: 1
    resources:
        mem_mb=12000
    log:
        OUT + "/logs/annotation.log"
    script:
        "../scripts/annotate.R"

rule multiqc:
    input:
        raw=expand(OUT + "/fastqc/raw/{sample}_R{mate}_fastqc.zip", sample=IDS, mate=[1, 2]),
        trimmed=expand(OUT + "/trimmed/{sample}_val_{mate}_fastqc.zip", sample=IDS, mate=[1, 2]),
        trimming=expand(OUT + "/trimmed/{sample}_R{mate}.fastq.gz_trimming_report.txt", sample=IDS, mate=[1, 2]),
        mapping=expand(OUT + "/bam/{sample}/{sample}_PE_report.txt", sample=IDS),
        splitting=expand(OUT + "/methylation/{sample}/{sample}_pe_splitting_report.txt", sample=IDS)
    output:
        OUT + "/multiqc/multiqc_report.html"
    params:
        out=OUT + "/multiqc", root=OUT
    resources:
        mem_mb=4000
    log:
        OUT + "/logs/multiqc.log"
    shell:
        "multiqc {params.root:q} --force --outdir {params.out:q} --filename multiqc_report.html > {log:q} 2>&1"

rule provenance:
    input:
        summary=OUT + "/analysis/summary.json",
        annotation=OUT + "/annotation/summary.json",
        samples=config["samples"],
        fasta=REF + "/source/hg38.fa.gz",
        genes=REF + "/source/genes.txt.gz",
        islands=REF + "/source/islands.txt.gz"
    output:
        OUT + "/provenance/run.json"
    params:
        cfg=config
    resources:
        mem_mb=256
    script:
        "../scripts/provenance.py"
